# Copy to .env (never commit .env). Everything is optional for a local demo.
AUTH_MODE=demo                  # demo for local use, firebase for real deployments
TEACHER_PIN=change-me           # demo mode only; random if unset and printed in the server log
ID_SALT=change-me-too           # salts the pseudonymous ids used in storage and logs

# Gemini through Google AI Studio ...
GEMINI_API_KEY=
# ... or through Vertex AI (uses Application Default Credentials on Cloud Run)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash   # check the current model name in Google AI Studio / Vertex AI

RATE_PER_MINUTE=30
# ALLOWED_ORIGINS=https://your-frontend.example   # CORS is closed unless you set this
